<%- include('partials/header') %>
<section class="hero"><div><h1>ADVANCED DRONE <span>SOLUTIONS</span><br>FOR A SMARTER FUTURE</h1><p>Falcon develops practical UAV platforms for solar panel cleaning, agriculture and specialized commercial missions.</p><div class="actions"><a class="btn" href="/drones">EXPLORE DRONES</a><a class="btn outline" href="/solutions">OUR SOLUTIONS</a></div></div></section>
<section class="section"><div class="sectionhead"><div><h2>OUR DRONES</h2><div class="under"></div></div><a class="btn outline" href="/drones">VIEW ALL DRONES</a></div><div class="grid4"><% drones.forEach(d=>{ %><article class="card"><div class="droneimg" style="background-image:url('<%= d.image %>')"></div><div class="cardbody"><h3><%= d.name %></h3><div class="cat"><%= d.category %></div><p><%= d.short %></p><a class="btn dark" href="/drones/<%= d.slug %>">VIEW DETAILS</a></div></article><% }) %></div></section>
<section class="section dark"><div class="sectionhead"><div><h2>OUR SOLUTIONS</h2><div class="under"></div></div></div><div class="solutions"><div class="solution"><div class="icon">✦</div><h3>SOLAR CLEANING</h3><p>Drone-assisted brush cleaning concepts for commercial and rooftop solar installations.</p></div><div class="solution"><div class="icon">⌖</div><h3>AUTONOMOUS MISSIONS</h3><p>GPS-enabled mission workflows, route planning and return-to-home capability.</p></div><div class="solution"><div class="icon">◇</div><h3>AGRICULTURE</h3><p>Precision spraying platforms designed around efficient field operations.</p></div><div class="solution"><div class="icon">⚙</div><h3>CUSTOM UAV</h3><p>Engineering-led UAV configurations for specialized payloads and applications.</p></div></div></section>
<section class="section"><div class="aboutgrid"><div><h2>ABOUT FALCON</h2><div class="under"></div><p>Falcon is a Pakistan-based drone technology company focused on practical UAV systems for solar cleaning, agriculture and specialized commercial applications.</p><p>We combine mechanical engineering, fabrication and autonomous-flight technology to develop application-focused platforms.</p><a class="btn" href="/about">READ MORE</a></div><div class="aboutphoto"></div></div></section>

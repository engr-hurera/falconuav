<%- include('partials/header') %>
<section class="section"><div class="detail"><div><div class="bigimage" style="background-image:url('<%= drone.image %>')"></div></div><div><div class="cat"><%= drone.category %></div><h1><%= drone.name %></h1><p><%= drone.description %></p><div class="stock">✓ AVAILABLE FOR INQUIRY</div><div class="price"><%= drone.price %></div><div class="actions"><button class="btn" onclick="openQuote('<%= drone.name %>')">GET A QUOTE</button><button class="btn dark" onclick="document.getElementById('order').scrollIntoView({behavior:'smooth'})">BUY NOW</button></div><div class="specs"><% Object.entries(drone.specs).forEach(([k,v])=>{ %><div class="spec"><small><%= k %></small><b><%= v %></b></div><% }) %></div><div class="hero-note">* Final performance depends on airframe configuration, payload, battery, environment and mission setup.</div></div></div><div class="tabs"><h2>ABOUT THIS PLATFORM</h2><p><%= drone.description %></p><p>Contact Falcon sales for final configuration, payload, battery, navigation and pricing details.</p></div></section>
<section class="section dark" id="order"><div class="formwrap"><h2>BUY / ORDER REQUEST</h2><p>Submit your requirements. This is an order request; Falcon will confirm configuration, availability and payment terms.</p><form onsubmit="submitOrder(event)"><input type="hidden" name="drone" value="<%= drone.name %>"><div class="formgrid"><div class="field"><label>Name *</label><input name="name" required></div><div class="field"><label>Phone *</label><input name="phone" required></div><div class="field"><label>Email *</label><input name="email" type="email" required></div><div class="field"><label>Quantity</label><input name="quantity" type="number" min="1" value="1"></div><div class="field full"><label>Delivery Address</label><textarea name="address"></textarea></div><div class="field full"><label>Notes / Configuration</label><textarea name="notes" placeholder="Payload, battery, mission or other requirements..."></textarea></div></div><button class="btn" type="submit">SUBMIT ORDER REQUEST</button></form></div></section>
<div class="modal" id="quoteModal"><div class="modalbox"><div class="modalhead"><h2>GET A QUOTE</h2><span class="close" onclick="closeModal()">×</span></div><form onsubmit="submitQuote(event)"><input type="hidden" id="quoteDrone" name="drone"><div class="formgrid"><div class="field"><label>Your Name *</label><input name="name" required></div><div class="field"><label>Phone *</label><input name="phone" required></div><div class="field"><label>Email *</label><input name="email" type="email" required></div><div class="field full"><label>Message</label><textarea name="message" placeholder="Tell us your requirements..."></textarea></div></div><button class="btn" type="submit">SUBMIT REQUEST</button></form></div></div>
<%- include('partials/footer') %>

<%- include("partials/header") %><section class="page-hero"><div class="container"><div class="eyebrow light">INTERNAL</div><h1>Falcon inquiries</h1><p>Private view of quotation and order requests.</p></div></section><section class="section admin"><div class="container"><h2>Quotation requests</h2><div class="table-wrap"><table><tr><th>Date</th><th>Name</th><th>Phone</th><th>Email</th><th>Drone</th><th>Message</th></tr><% quotes.forEach(q=>{ %><tr><td><%= new Date(q.date).toLocaleString() %></td><td><%= q.name %></td><td><%= q.phone %></td><td><%= q.email %></td><td><%= q.drone %></td><td><%= q.message %></td></tr><% }) %></table></div><h2>Order requests</h2><div class="table-wrap"><table><tr><th>Date</th><th>Name</th><th>Phone</th><th>Email</th><th>Drone</th><th>Qty</th><th>Address</th><th>Notes</th></tr><% orders.forEach(o=>{ %><tr><td><%= new Date(o.date).toLocaleString() %></td><td><%= o.name %></td><td><%= o.phone %></td><td><%= o.email %></td><td><%= o.drone %></td><td><%= o.quantity %></td><td><%= o.address %></td><td><%= o.notes %></td></tr><% }) %></table></div></div></section><%- include("partials/footer") %>

<%- include("partials/header") %><section class="pagehero"><h1>FALCON INQUIRIES</h1><p>Internal view of quotation and order requests saved by the backend.</p></section><section class="section admin"><h2>Quotation Requests</h2><table><tr><th>Date</th><th>Name</th><th>Phone</th><th>Email</th><th>Drone</th><th>Message</th></tr><% quotes.forEach(q=>{ %><tr><td><%= new Date(q.date).toLocaleString() %></td><td><%= q.name %></td><td><%= q.phone %></td><td><%= q.email %></td><td><%= q.drone %></td><td><%= q.message %></td></tr><% }) %></table><br><h2>Order Requests</h2><table><tr><th>Date</th><th>Name</th><th>Phone</th><th>Email</th><th>Drone</th><th>Qty</th><th>Address</th><th>Notes</th></tr><% orders.forEach(o=>{ %><tr><td><%= new Date(o.date).toLocaleString() %></td><td><%= o.name %></td><td><%= o.phone %></td><td><%= o.email %></td><td><%= o.drone %></td><td><%= o.quantity %></td><td><%= o.address %></td><td><%= o.notes %></td></tr><% }) %></table></section><%- include("partials/footer") %>
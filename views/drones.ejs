<%- include('partials/header') %>
<section class="page-hero"><div class="container"><div class="eyebrow light">FALCON / UAV PLATFORMS</div><h1>The fleet</h1><p>Solar cleaning and agricultural platforms, each designed around a specific operating requirement.</p></div></section>
<section class="section"><div class="container"><div class="fleet-grid fleet-grid-all"><% drones.forEach((d, i)=>{ %><a class="fleet-card" href="/drones/<%= d.slug %>"><div class="fleet-image"><img src="<%= d.image %>" alt="<%= d.name %> drone platform" loading="lazy"><span class="card-number"><%= String(i+1).padStart(2,'0') %></span></div><div class="fleet-body"><div><span class="category"><%= d.category %></span><h3><%= d.name %></h3><p><%= d.short %></p></div><span class="arrow">↗</span></div></a><% }) %></div></div></section>
<%- include('partials/footer') %>
